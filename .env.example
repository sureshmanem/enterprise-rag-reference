# Provider: fake (offline), azure, or openai
RAG_PROVIDER=fake

# Azure OpenAI / Azure AI Foundry
RAG_AZURE_ENDPOINT=
RAG_AZURE_API_KEY=
RAG_AZURE_API_VERSION=2024-10-21

# OpenAI
RAG_OPENAI_API_KEY=

# Models (deployment names on Azure)
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHAT_MODEL=gpt-4o-mini

# Chunking and retrieval
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_HYBRID=true
RAG_MIN_RELEVANCE=0.25

# Storage
RAG_PERSIST_DIR=.chroma
RAG_COLLECTION=documents

# SharePoint (Microsoft Graph, app-only)
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=
